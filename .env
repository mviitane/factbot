# Logical CPU that every FactBot container is pinned to (0-based index).
DEMO_CPU=7

# Host Collector (OTLP/HTTP). Containers use host networking, so localhost works.
OTLP_ENDPOINT=http://localhost:4318

# Host ports (loopback only, except the frontend; see FRONTEND_HOST). Roll-dice uses 8008, so these avoid it.
FRONTEND_PORT=8081
# Interface the frontend (web page + /fact API) listens on. 0.0.0.0 makes it reachable
# from the LAN at http://<host-ip>:8081/; 127.0.0.1 keeps it local. Other services stay local.
FRONTEND_HOST=0.0.0.0
ORCHESTRATOR_PORT=8082
FACTS_PORT=8083
# Change if you already run Ollama natively on 11434.
OLLAMA_PORT=11434

# Traffic cadence in seconds (one trace per tick).
TICK_SECONDS=60

# Fault injection for the facts service.
FACTS_ERROR_RATE=0      # 0.0-1.0 probability of an HTTP 500
FACTS_SLOW_MS=0         # added latency per lookup

# GenAI prompt/completion capture: no_content, span_only (attributes on the chat span,
# no extra logs), event_only, or span_and_event (both add a few logs per request).
CAPTURE_GENAI_CONTENT=span_only

# Set to 1 (e.g. FORCE_RECREATE=1 docker compose up -d) after editing ollama/Modelfile.
FORCE_RECREATE=0

# OBI (eBPF instrumentation for Ollama): image tag, and "text" to also print each
# captured request to `docker compose logs obi`.
OBI_VERSION=v0.15.2
OBI_TRACE_PRINTER=disabled
